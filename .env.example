# Timezone shared by backend + go2rtc so recording filenames, event timestamps
# and retention day boundaries all agree. Required, no default.
TZ=America/Toronto

# Static LAN IP for the proxy on the pre-existing "lan" macvlan network
# (see docker-compose.yml). The macvlan network itself must already exist
# on the Docker host (created outside Compose, e.g. `docker network create
# -d macvlan ...`) and this IP must be free within its subnet.
PROXY_LAN_IP=10.2.5.200

# NFS server address and export path for camera recordings. Mounted
# directly by Docker's NFS volume driver -- no host-level fstab entry
# needed. Use a folder dedicated to CCAM, not shared with other NVR apps.
NAS_NFS_ADDR=10.2.4.40
NAS_NFS_PATH=/mnt/tank/appdata/ccam

# First admin account, created automatically on first backend startup if the
# users table is empty. Change the password before first run.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-before-first-run

# Random 32-byte hex key used to encrypt session cookies. Generate your own with:
#   openssl rand -hex 32
SESSION_KEY=replace-with-openssl-rand-hex-32

# Port exposed on the Docker host's own address for the nginx proxy, in
# addition to the dedicated macvlan IP above (useful as a fallback / for
# local testing directly against the host).
HTTP_PORT=8080
