# Timezone shared by backend + go2rtc so recording filenames, event timestamps
# and retention day boundaries all agree. Required, no default.
TZ=America/Toronto

# Absolute host path to the NAS share, already mounted at the OS level
# (SMB/NFS via fstab or equivalent). Required, no default.
NAS_MOUNT_PATH=/mnt/nas/ccam

# First admin account, created automatically on first backend startup if the
# users table is empty. Change the password before first run.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-before-first-run

# Random 32-byte hex key used to encrypt session cookies. Generate your own with:
#   openssl rand -hex 32
SESSION_KEY=replace-with-openssl-rand-hex-32

# Port exposed on the host for the nginx proxy (single entrypoint for the app)
HTTP_PORT=8080
